# ---------------------------------------------------------------
# 环境变量示例：复制为 .env 后按需修改
#   cp .env.example .env
# 说明：.env 已在 .gitignore 中，不会被提交
# ---------------------------------------------------------------

# 服务监听（容器内保持 0.0.0.0，否则外部无法访问）
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 会话密钥（必填）：生成方式 -> openssl rand -base64 32
# 未设置时应用会直接退出并提示
SESSION_SECRET=

# 站点名称（可选，用于页面标题与页脚默认文案）
SITE_NAME=MyBlog

# 首次启动创建的管理员账号
# 注意：ADMIN_PASSWORD 仅在用户表为空时生效，之后请走后台「我的资料」修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=