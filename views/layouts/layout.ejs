<!DOCTYPE html>
<html lang="zh-CN" class="<%= locals.darkMode ? 'dark' : '' %>">
<head>
  <%- include('../partials/theme-init') %>
  <% const SITE_TITLE = (locals.settings && locals.settings.site_title) || siteName; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.titleKey ? t(locals.titleKey) + ' · ' + SITE_TITLE : (locals.title ? locals.title + ' · ' + SITE_TITLE : SITE_TITLE) %></title>
  <link rel="stylesheet" href="/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="<%= (locals.settings && locals.settings.site_logo) || '/favicon.svg' %>">
  <%- include('../partials/brand-color') %>
</head>
<body>
  <!-- 顶部导航栏 -->
  <header>
  <div class="container header-container">
    <div class="logo">
      <% if (locals.settings && locals.settings.site_logo) { %>
        <img src="<%= locals.settings.site_logo %>" alt="logo" class="site-logo">
      <% } else { %>
        <i class="fas fa-feather-alt"></i>
      <% } %>
      <a href="/"><span><%= SITE_TITLE %></span></a>
    </div>

    <!-- PC 横向导航 -->
    <nav class="pc-nav">
      <a href="/"><%= t('nav.home') %></a>
      <a href="<%= locals.isStatic ? '/posts.html' : '/posts' %>"><%= t('nav.posts') %></a>
      <a href="/#about"><%= t('nav.about') %></a>
    </nav>

    <div class="nav-right">
      <%- include('../partials/theme-switch', { variant: 'pc', id: 'themeTogglePc' }) %>
      <button class="search-toggle" id="searchToggle" type="button" aria-label="<%= t('nav.search') %>">
        <i class="fas fa-search"></i>
      </button>
      <button class="menu-toggle" id="menuToggle" type="button" aria-label="<%= t('nav.menu') %>">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </div>
</header>

  <!-- 全屏菜单 -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-header">
      <div class="logo">
        <% if (locals.settings && locals.settings.site_logo) { %>
          <img src="<%= locals.settings.site_logo %>" alt="logo" class="site-logo">
        <% } else { %>
          <i class="fas fa-feather-alt"></i>
        <% } %>
        <span><%= SITE_TITLE %></span>
      </div>
      <button class="menu-close" id="menuClose" type="button" aria-label="<%= t('nav.close') %>">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <ul class="mobile-menu-list">
      <li><a href="/"><%= t('nav.home') %><span class="arrow">›</span></a></li>
      <li><a href="<%= locals.isStatic ? '/posts.html' : '/posts' %>"><%= t('nav.posts') %><span class="arrow">›</span></a></li>
      <li><a href="/#about"><%= t('nav.about') %><span class="arrow">›</span></a></li>
    </ul>

    <div class="mobile-menu-footer">
      <%- include('../partials/theme-switch', { variant: 'mobile', id: 'themeToggleMobile' }) %>
      <% if (locals.settings && locals.settings.social_links) { locals.settings.social_links.forEach(it => { %>
        <a href="<%= it.type === 'email' ? (/^mailto:/.test(it.url) ? it.url : 'mailto:' + it.url) : it.url %>"
           target="_blank" rel="noopener" class="circle-btn">
          <i class="<%= locals.socialIcons[it.type] || 'fas fa-link' %>"></i>
          <span><%= locals.socialLabels[it.type] || '' %></span>
        </a>
      <% }) } %>
    </div>
  </div>

  <!-- 页面内容 -->
  <main>
    <%- body %>
  </main>

  <!-- 底部栏 -->
  <footer>
    <div class="container">
      <div class="footer-content">
        <div class="footer-column">
          <h3><%= t('footer.quickLinks') %></h3>
          <ul class="footer-links">
            <li><a href="/"><%= t('nav.home') %></a></li>
            <li><a href="<%= locals.isStatic ? '/posts.html' : '/posts' %>"><%= t('nav.posts') %></a></li>
            <li><a href="/#featured"><%= t('footer.featured') %></a></li>
            <li><a href="/#latest"><%= t('footer.latest') %></a></li>
            <li><a href="/#about"><%= t('nav.about') %></a></li>
          </ul>
        </div>
        <div class="footer-column">
          <h3><%= SITE_TITLE %></h3>
          <ul class="footer-links">
            <% if (locals.settings && locals.settings.footer_subtitle) { %>
              <li><%= locals.settings.footer_subtitle %></li>
            <% } %>
          </ul>
        </div>
      </div>
      <% if (locals.settings && locals.settings.social_links && locals.settings.social_links.length) { %>
      <div class="social-links">
        <% locals.settings.social_links.forEach(it => { %>
          <a href="<%= it.type === 'email' ? (/^mailto:/.test(it.url) ? it.url : 'mailto:' + it.url) : it.url %>"
             target="_blank" rel="noopener" class="social-link" title="<%= locals.socialLabels[it.type] || '' %>">
            <i class="<%= locals.socialIcons[it.type] || 'fas fa-link' %>"></i>
          </a>
        <% }) %>
      </div>
      <% } %>
      <div class="copyright">
        <p>&copy; <%= new Date().getFullYear() %> <%= (locals.settings && locals.settings.footer_text) || (SITE_TITLE + '. Powered by Node.js.') %></p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>