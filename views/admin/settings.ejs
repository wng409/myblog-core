<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../partials/theme-init') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin.settings.title') %></title>
  <link rel="stylesheet" href="/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body data-csrf="<%= csrfToken %>" data-upload-failed="<%= t('admin.banner.uploadFailed') %>" data-upload-invalid="<%= t('admin.banner.uploadInvalid') %>" data-lang="<%= lang %>">
  <div class="admin-container">
    <div class="admin-header">
      <h1><%= t('admin.settings.title') %></h1>
      <a href="/" class="btn btn-secondary"><%= t('admin.viewSite') %></a>
    </div>
    <%- include('../partials/admin-nav', { active: 'settings', csrfToken }) %>

    <!-- Banner 管理 -->
    <div class="settings-section">
      <h2><%= t('admin.banner.heading') %></h2>
      <p><%= t('admin.banner.desc') %></p>

      <form method="POST" action="/admin/settings/banner" id="bannerForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="bannerItems" id="bannerItemsInput">

        <table class="banner-table" id="bannerTable">
          <thead>
            <tr>
              <th style="width:26%;"><%= t('admin.banner.colPost') %></th>
              <th style="width:22%;"><%= t('admin.banner.colTitle') %></th>
              <th style="width:32%;"><%= t('admin.banner.colImage') %></th>
              <th style="width:20%;"><%= t('admin.banner.colActions') %></th>
            </tr>
          </thead>
          <tbody id="bannerList">
            <% bannerItems.forEach((item, index) => { %>
              <tr data-index="<%= index %>">
                <td>
                  <select name="postId" class="banner-post">
                    <option value=""><%= t('admin.banner.none') %></option>
                    <% posts.forEach(post => { %>
                      <option value="<%= post.id %>" <%= item.postId == post.id ? 'selected' : '' %>>
                        <%= post.title %>
                      </option>
                    <% }) %>
                  </select>
                </td>
                <td><input type="text" name="title" value="<%= item.title || '' %>" placeholder="<%= t('admin.banner.titlePh') %>"></td>
                <td>
                  <div class="img-input-wrap">
                    <input type="text" name="image" value="<%= item.image || '' %>" placeholder="<%= t('admin.banner.imagePh') %>">
                    <button type="button" class="btn-upload" data-loading="<%= t('admin.banner.uploading') %>"><%= t('admin.banner.upload') %></button>
                  </div>
                </td>
                <td>
                  <button type="button" class="btn-sm btn-secondary" data-action="up"><%= t('admin.banner.up') %></button>
                  <button type="button" class="btn-sm btn-secondary" data-action="down"><%= t('admin.banner.down') %></button>
                  <button type="button" class="btn-sm btn-danger" data-action="delete"><%= t('admin.banner.delete') %></button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <button type="button" id="addBannerBtn" class="btn" style="margin-top:10px;"><%= t('admin.banner.add') %></button>
        <button type="submit" class="btn" style="margin-top:10px; margin-left:10px;"><%= t('admin.banner.save') %></button>
      </form>
    </div>

    <!-- 推荐文章管理 -->
    <div class="settings-section">
      <h2><%= t('admin.featured.heading') %></h2>
      <p><%= t('admin.featured.desc') %></p>

      <form method="POST" action="/admin/settings" id="featuredForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="featuredIds" id="featuredIdsInput">
        <input type="hidden" name="bannerItems" id="bannerItemsInput2" value="<%= JSON.stringify(bannerItems) %>">

        <div class="form-group">
          <label><%= t('admin.featured.select') %></label>
          <select id="featuredSelect" multiple style="height:150px; width:100%; padding:8px;">
            <% posts.forEach(post => { %>
              <option value="<%= post.id %>" <%= featuredIds.includes(post.id) ? 'selected' : '' %>>
                <%= post.title %>
              </option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn"><%= t('admin.featured.save') %></button>
      </form>
    </div>

    <!-- 站点信息（个性化设置） -->
    <div class="settings-section">
      <h2><%= t('admin.settings.site') %></h2>

      <form method="POST" action="/admin/settings/site">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="siteTitleInput"><%= t('admin.settings.siteTitle') %></label>
          <input type="text" id="siteTitleInput" name="site_title" value="<%= settings.site_title || '' %>">
        </div>
        <div class="form-group">
          <label for="siteSubtitleInput"><%= t('admin.settings.siteSubtitle') %></label>
          <input type="text" id="siteSubtitleInput" name="site_subtitle" value="<%= settings.site_subtitle || '' %>">
        </div>
        <div class="form-group">
          <label for="themeColorInput"><%= t('admin.settings.themeColor') %></label>
          <input type="color" id="themeColorInput" name="theme_color" value="<%= settings.theme_color || '#e60012' %>">
        </div>
        <div class="form-group">
          <label for="aboutBioInput"><%= t('admin.settings.aboutBio') %></label>
          <textarea id="aboutBioInput" name="about_bio" rows="4"><%= settings.about_bio || '' %></textarea>
        </div>
        <div class="form-group">
          <label for="footerTextInput"><%= t('admin.settings.footerText') %></label>
          <input type="text" id="footerTextInput" name="footer_text" value="<%= settings.footer_text || '' %>">
        </div>
        <button type="submit" class="btn"><%= t('admin.settings.saveSite') %></button>
      </form>
    </div>

    <!-- 语言 -->
    <div class="settings-section">
      <h2><%= t('admin.settings.lang') %></h2>
      <p><%= t('admin.settings.langDesc') %></p>

      <form method="POST" action="/admin/settings/language">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="siteLangSelect"><%= t('admin.settings.lang') %></label>
          <select name="site_lang" id="siteLangSelect">
            <% LANGS.forEach(code => { %>
              <option value="<%= code %>" <%= siteLang === code ? 'selected' : '' %>><%= getLangLabel(code) %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn"><%= t('admin.settings.saveLang') %></button>
      </form>
    </div>

    <!-- 静态站导出 -->
    <div class="settings-section">
      <h2><%= t('admin.export.heading') %></h2>
      <p><%= t('admin.export.desc') %></p>
      <form method="POST" action="/admin/export-build" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-export-build"><%= t('admin.export.build') %></button>
      </form>
      <a href="/admin/export-download" class="btn btn-secondary"><%= t('admin.export.download') %></a>
    </div>
  </div>

  <!-- 新增行模板 -->
  <template id="bannerRowTemplate">
    <tr>
      <td>
        <select name="postId" class="banner-post">
          <option value=""><%= t('admin.banner.none') %></option>
          <% posts.forEach(post => { %>
            <option value="<%= post.id %>"><%= post.title %></option>
          <% }) %>
        </select>
      </td>
      <td><input type="text" name="title" placeholder="<%= t('admin.banner.titlePh') %>"></td>
      <td>
        <div class="img-input-wrap">
          <input type="text" name="image" placeholder="<%= t('admin.banner.imagePh') %>">
          <button type="button" class="btn-upload" data-loading="<%= t('admin.banner.uploading') %>"><%= t('admin.banner.upload') %></button>
        </div>
      </td>
      <td>
        <button type="button" class="btn-sm btn-secondary" data-action="up"><%= t('admin.banner.up') %></button>
        <button type="button" class="btn-sm btn-secondary" data-action="down"><%= t('admin.banner.down') %></button>
        <button type="button" class="btn-sm btn-danger" data-action="delete"><%= t('admin.banner.delete') %></button>
      </td>
    </tr>
  </template>

  <script src="/js/admin-settings.js"></script>
  <script src="/js/toast.js"></script>
</body>
</html>