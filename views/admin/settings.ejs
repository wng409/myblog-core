<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../partials/theme-init') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin.settings.title') %></title>
  <link rel="stylesheet" href="/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .admin-container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
    .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .admin-header h1 { color: var(--hw-red); }
    .btn { display: inline-block; padding: 10px 20px; background: var(--hw-red); color: white; border: none; border-radius: 6px; cursor: pointer; text-decoration: none; }
    .btn:hover { background: #c4000f; }
    .btn-secondary { background: var(--hw-medium-gray); }
    .btn-secondary:hover { background: #555; }
    .admin-nav { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; align-items: center; }
    .admin-nav a { color: var(--text); text-decoration: none; padding: 8px 16px; border-radius: 6px; }
    .admin-nav a:hover { background: var(--hw-light-gray); }
    .admin-nav a.active { background: var(--hw-light-gray); font-weight: 500; }
    .admin-nav form { display: inline; margin: 0; }
    .admin-nav form button { color: var(--text); background: none; border: none; cursor: pointer; padding: 8px 16px; border-radius: 6px; font-size: 1rem; }
    .admin-nav form button:hover { background: var(--hw-light-gray); }
    .settings-section { margin-bottom: 40px; border: 1px solid var(--hw-border); padding: 20px; border-radius: 8px; }
    .settings-section h2 { margin-bottom: 20px; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 5px; font-weight: 500; }
    .form-group input, .form-group select { width: 100%; padding: 8px 12px; border: 1px solid var(--hw-border); border-radius: 4px; }
    .banner-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    .banner-table th, .banner-table td { padding: 8px; border: 1px solid var(--hw-border); text-align: left; vertical-align: middle; }
    .banner-table input, .banner-table select { width: 100%; padding: 6px; border: 1px solid var(--hw-border); border-radius: 4px; box-sizing: border-box; }
    .btn-sm { padding: 4px 8px; font-size: 0.9rem; }
    .img-input-wrap { display: flex; gap: 6px; align-items: center; }
    .img-input-wrap input { flex: 1; min-width: 0; }
    .btn-upload { padding: 6px 12px; background: var(--hw-red); color: #fff; border: none; border-radius: 4px; cursor: pointer; white-space: nowrap; font-size: 0.85rem; }
    .btn-upload:hover { background: #c4000f; }
    .btn-upload:disabled { opacity: 0.6; cursor: not-allowed; }
  </style>
</head>
<body data-csrf="<%= csrfToken %>" data-upload-failed="<%= t('admin.banner.uploadFailed') %>" data-upload-invalid="<%= t('admin.banner.uploadInvalid') %>" data-lang="<%= lang %>">
  <div class="admin-container">
    <div class="admin-header">
      <h1><%= t('admin.settings.title') %></h1>
      <a href="/" class="btn btn-secondary"><%= t('admin.viewSite') %></a>
    </div>
    <%- include('../partials/admin-nav', { active: 'settings', csrfToken }) %>

    <!-- Banner 管理 -->
    <div class="settings-section">
      <h2><%= t('admin.banner.heading') %></h2>
      <p><%= t('admin.banner.desc') %></p>

      <form method="POST" action="/admin/settings/banner" id="bannerForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="bannerItems" id="bannerItemsInput">

        <table class="banner-table" id="bannerTable">
          <thead>
            <tr>
              <th style="width:26%;"><%= t('admin.banner.colPost') %></th>
              <th style="width:22%;"><%= t('admin.banner.colTitle') %></th>
              <th style="width:32%;"><%= t('admin.banner.colImage') %></th>
              <th style="width:20%;"><%= t('admin.banner.colActions') %></th>
            </tr>
          </thead>
          <tbody id="bannerList">
            <% bannerItems.forEach((item, index) => { %>
              <tr data-index="<%= index %>">
                <td>
                  <select name="postId" class="banner-post">
                    <option value=""><%= t('admin.banner.none') %></option>
                    <% posts.forEach(post => { %>
                      <option value="<%= post.id %>" <%= item.postId == post.id ? 'selected' : '' %>>
                        <%= post.title %>
                      </option>
                    <% }) %>
                  </select>
                </td>
                <td><input type="text" name="title" value="<%= item.title || '' %>" placeholder="<%= t('admin.banner.titlePh') %>"></td>
                <td>
                  <div class="img-input-wrap">
                    <input type="text" name="image" value="<%= item.image || '' %>" placeholder="<%= t('admin.banner.imagePh') %>">
                    <button type="button" class="btn-upload" data-loading="<%= t('admin.banner.uploading') %>"><%= t('admin.banner.upload') %></button>
                  </div>
                </td>
                <td>
                  <button type="button" class="btn-sm btn-secondary" data-action="up"><%= t('admin.banner.up') %></button>
                  <button type="button" class="btn-sm btn-secondary" data-action="down"><%= t('admin.banner.down') %></button>
                  <button type="button" class="btn-sm" style="background:#c4000f;color:white;" data-action="delete"><%= t('admin.banner.delete') %></button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <button type="button" id="addBannerBtn" class="btn" style="margin-top:10px;"><%= t('admin.banner.add') %></button>
        <button type="submit" class="btn" style="margin-top:10px; margin-left:10px;"><%= t('admin.banner.save') %></button>
      </form>
    </div>

    <!-- 推荐文章管理 -->
    <div class="settings-section">
      <h2><%= t('admin.featured.heading') %></h2>
      <p><%= t('admin.featured.desc') %></p>

      <form method="POST" action="/admin/settings" id="featuredForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="featuredIds" id="featuredIdsInput">
        <input type="hidden" name="bannerItems" id="bannerItemsInput2" value="<%= JSON.stringify(bannerItems) %>">

        <div class="form-group">
          <label><%= t('admin.featured.select') %></label>
          <select id="featuredSelect" multiple style="height:150px; width:100%; padding:8px;">
            <% posts.forEach(post => { %>
              <option value="<%= post.id %>" <%= featuredIds.includes(post.id) ? 'selected' : '' %>>
                <%= post.title %>
              </option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn"><%= t('admin.featured.save') %></button>
      </form>
    </div>

    <!-- 语言 / Language -->
    <div class="settings-section">
      <h2>语言 / Language</h2>
      <p>选择前台首页的显示语言。 / Choose the display language for the front-end home page.</p>

      <form method="POST" action="/admin/settings/language">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="siteLangSelect">语言 / Language</label>
          <select name="site_lang" id="siteLangSelect">
            <% LANGS.forEach(code => { %>
              <option value="<%= code %>" <%= siteLang === code ? 'selected' : '' %>><%= getLangLabel(code) %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn">保存语言 / Save language</button>
      </form>
    </div>
  </div>

  <!-- 新增行模板 -->
  <template id="bannerRowTemplate">
    <tr>
      <td>
        <select name="postId" class="banner-post">
          <option value=""><%= t('admin.banner.none') %></option>
          <% posts.forEach(post => { %>
            <option value="<%= post.id %>"><%= post.title %></option>
          <% }) %>
        </select>
      </td>
      <td><input type="text" name="title" placeholder="<%= t('admin.banner.titlePh') %>"></td>
      <td>
        <div class="img-input-wrap">
          <input type="text" name="image" placeholder="<%= t('admin.banner.imagePh') %>">
          <button type="button" class="btn-upload" data-loading="<%= t('admin.banner.uploading') %>"><%= t('admin.banner.upload') %></button>
        </div>
      </td>
      <td>
        <button type="button" class="btn-sm btn-secondary" data-action="up"><%= t('admin.banner.up') %></button>
        <button type="button" class="btn-sm btn-secondary" data-action="down"><%= t('admin.banner.down') %></button>
        <button type="button" class="btn-sm" style="background:#c4000f;color:white;" data-action="delete"><%= t('admin.banner.delete') %></button>
      </td>
    </tr>
  </template>

  <script src="/js/admin-settings.js"></script>
  <script src="/js/toast.js"></script>
</body>
</html>