<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/theme-init') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= t('admin.settings.title') %></title>
  <link rel="stylesheet" href="/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <%- include('../partials/brand-color') %>
</head>
<body data-csrf="<%= csrfToken %>" data-lang="<%= lang %>"
      data-upload-failed="<%= t('admin.banner.uploadFailed') %>"
      data-upload-invalid="<%= t('admin.banner.uploadInvalid') %>"
      data-banner-untitled="<%= t('admin.banner.untitled') %>"
      data-banner-preview-empty="<%= t('admin.banner.previewEmpty') %>">
  <div class="admin-container">
    <div class="admin-header">
      <h1><%= t('admin.settings.title') %></h1>
      <div class="header-actions">
        <a href="/" class="btn btn-secondary"><%= t('admin.viewSite') %></a>
      </div>
    </div>

    <%- include('../partials/admin-nav', { active: 'settings', csrfToken }) %>

    <!-- Banner 轮播管理 -->
    <div class="settings-section">
      <h2><%= t('admin.banner.heading') %></h2>
      <p><%= t('admin.banner.desc') %></p>

      <form method="POST" action="/admin/settings/banner" id="bannerForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="bannerVersion" value="<%= bannerRaw %>">
        <input type="hidden" name="bannerItems" id="bannerItemsInput">

        <div class="banner-list" id="bannerList">
          <p class="empty-tip" id="bannerEmptyTip"<% if (bannerItems && bannerItems.length > 0) { %> style="display:none"<% } %>><%= t('admin.banner.empty') %></p>
          <% bannerItems.forEach((item, index) => { %>
            <div class="banner-row" data-index="<%= index %>" draggable="true">
              <span class="drag-handle" title="<%= t('admin.banner.dragHint') %>"><i class="fas fa-grip-vertical"></i></span>

              <div class="banner-summary mobile-only">
                <span class="banner-thumb">
                  <% if (item.image) { %><img src="<%= item.image %>" alt=""><% } %>
                </span>
                <span class="banner-summary-title"><%= item.title || t('admin.banner.untitled') %></span>
                <i class="fas fa-chevron-right"></i>
              </div>

              <div class="banner-fields">
                <div class="hm-select-container">
                  <select name="postId" class="banner-post">
                    <option value=""><%= t('admin.banner.none') %></option>
                    <% posts.forEach(post => { %>
                      <option value="<%= post.id %>" <%= item.postId == post.id ? 'selected' : '' %>>
                        <%= post.title %>
                      </option>
                    <% }) %>
                  </select>
                  <div class="hm-select-trigger"><span class="trigger-text"></span><span class="icon">▼</span></div>
                  <ul class="hm-select-options"></ul>
                </div>
                <input type="text" name="title" value="<%= item.title || '' %>" placeholder="<%= t('admin.banner.titlePh') %>">
                <div class="img-input-wrap">
                  <input type="text" name="image" value="<%= item.image || '' %>" placeholder="<%= t('admin.banner.imagePh') %>">
                  <button type="button" class="img-link-btn" title="<%= t('admin.banner.uploadImage') %>" aria-label="<%= t('admin.banner.uploadImage') %>">
                    <i class="fas fa-link"></i>
                  </button>
                </div>
              </div>

              <button type="button" class="icon-btn icon-btn-danger banner-remove" title="<%= t('admin.banner.delete') %>" aria-label="<%= t('admin.banner.delete') %>">
                <i class="fas fa-trash-alt"></i>
              </button>
            </div>
          <% }) %>
        </div>

        <div class="admin-toolbar">
          <button type="button" id="addBannerBtn" class="btn"><i class="fas fa-plus"></i> <%= t('admin.banner.add') %></button>
          <button type="submit" class="btn"><%= t('admin.banner.save') %></button>
        </div>
      </form>
    </div>

    <!-- 推荐文章（胶囊标签方案） -->
    <div class="settings-section">
      <h2><%= t('admin.featured.heading') %></h2>
      <p><%= t('admin.featured.desc') %></p>

      <form method="POST" action="/admin/settings" id="featuredForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="bannerVersion" value="<%= bannerRaw %>">
        <input type="hidden" name="featuredIds" id="featuredIdsInput">
        <input type="hidden" name="bannerItems" id="bannerItemsInput2" value="<%= JSON.stringify(bannerItems) %>">
        <input type="hidden" name="featuredIdsSeed" id="featuredIdsSeed" value="<%= JSON.stringify(featuredIds) %>">

        <div class="form-group">
          <label for="featuredSearch"><%= t('admin.featured.search') %></label>
          <input type="text" id="featuredSearch" placeholder="<%= t('admin.featured.searchPh') %>">
        </div>

        <div class="chip-list" id="featuredChips"></div>

        <div class="featured-candidates" id="featuredCandidates">
          <% posts.forEach(post => { %>
            <button type="button" class="candidate-chip" data-id="<%= post.id %>" data-title="<%= post.title %>">
              <i class="fas fa-plus"></i> <%= post.title %>
            </button>
          <% }) %>
        </div>

        <div class="admin-toolbar">
          <button type="submit" class="btn"><%= t('admin.featured.save') %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- 新增 Banner 行模板 -->
  <template id="bannerRowTemplate">
    <div class="banner-row" draggable="true">
      <span class="drag-handle" title="<%= t('admin.banner.dragHint') %>"><i class="fas fa-grip-vertical"></i></span>

      <div class="banner-summary mobile-only">
        <span class="banner-thumb"></span>
        <span class="banner-summary-title"><%= t('admin.banner.untitled') %></span>
        <i class="fas fa-chevron-right"></i>
      </div>

      <div class="banner-fields">
        <div class="hm-select-container">
          <select name="postId" class="banner-post">
            <option value=""><%= t('admin.banner.none') %></option>
            <% posts.forEach(post => { %>
              <option value="<%= post.id %>"><%= post.title %></option>
            <% }) %>
          </select>
          <div class="hm-select-trigger"><span class="trigger-text"></span><span class="icon">▼</span></div>
          <ul class="hm-select-options"></ul>
        </div>
        <input type="text" name="title" placeholder="<%= t('admin.banner.titlePh') %>">
        <div class="img-input-wrap">
          <input type="text" name="image" placeholder="<%= t('admin.banner.imagePh') %>">
          <button type="button" class="img-link-btn" title="<%= t('admin.banner.uploadImage') %>" aria-label="<%= t('admin.banner.uploadImage') %>">
            <i class="fas fa-link"></i>
          </button>
        </div>
      </div>

      <button type="button" class="icon-btn icon-btn-danger banner-remove" title="<%= t('admin.banner.delete') %>" aria-label="<%= t('admin.banner.delete') %>">
        <i class="fas fa-trash-alt"></i>
      </button>
    </div>
  </template>

  <!-- 移动端 Banner 编辑抽屉 -->
  <div class="sheet-mask" id="bannerSheetMask"></div>
  <div class="sheet" id="bannerSheet" role="dialog" aria-modal="true" aria-label="<%= t('admin.banner.editTitle') %>">
    <div class="sheet-handle"></div>
    <div class="sheet-header">
      <h3><%= t('admin.banner.editTitle') %></h3>
      <button type="button" class="sheet-close" id="bannerSheetClose" aria-label="<%= t('admin.banner.close') %>"><i class="fas fa-times"></i></button>
    </div>
    <div class="sheet-body" id="bannerSheetBody"></div>
    <div class="sheet-footer">
      <button type="button" class="btn btn-secondary" id="bannerSheetCancel"><%= t('posts.editor.cancel') %></button>
      <button type="button" class="btn" id="bannerSheetSave"><%= t('admin.banner.save') %></button>
    </div>
  </div>

  <script src="/js/admin-settings.js" defer></script>
  <script src="/js/toast.js"></script>
</body>
</html>