<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../../partials/theme-init') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post ? t('posts.editor.edit') : t('posts.editor.new') %></title>
  <link rel="stylesheet" href="/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <!-- EasyMDE Markdown 编辑器 -->
<link rel="stylesheet" href="/css/easymde.min.css">
  <style>
    .admin-container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
    .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .admin-header h1 { color: var(--hw-red); }
    .btn { display: inline-block; padding: 10px 20px; background: var(--hw-red); color: white; border: none; border-radius: 6px; cursor: pointer; text-decoration: none; }
    .btn:hover { background: #c4000f; }
    .btn-secondary { background: var(--hw-medium-gray); }
    .btn-secondary:hover { background: #555; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 5px; font-weight: 500; }
    .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 8px 12px; border: 1px solid var(--hw-border); border-radius: 4px; font-size: 1rem; }
    .form-group textarea { height: 400px; }
    .form-group .file-input-wrapper { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .form-group .file-input-wrapper input[type="file"] { flex:1; min-width: 200px; }
    .form-group .file-input-wrapper .or-text { color: var(--hw-medium-gray); padding: 0 8px; }
    .form-group .current-image { margin-top: 10px; }
    .form-group .current-image img { max-width: 200px; max-height: 150px; border-radius: 4px; border: 1px solid var(--hw-border); }
    .form-group .hint { font-size: 13px; color: var(--hw-medium-gray); margin-top: 4px; }
    .form-actions { display: flex; gap: 10px; margin-top: 20px; }
  </style>
</head>
<body>
  <div class="admin-container">
    <div class="admin-header">
      <h1><%= post ? t('posts.editor.edit') : t('posts.editor.new') %></h1>
      <a href="/admin" class="btn btn-secondary"><%= t('posts.editor.backToList') %></a>
    </div>
    <form method="POST" action="<%= action %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
      <!-- [修复] CSRF token -->
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label><%= t('posts.editor.title') %></label>
        <input type="text" name="title" value="<%= post ? post.title : '' %>" required>
      </div>
      <div class="form-group">
        <label><%= t('posts.editor.slug') %></label>
        <input type="text" name="slug" value="<%= post ? post.slug : '' %>" placeholder="<%= t('posts.editor.slugPlaceholder') %>">
      </div>
      <div class="form-group">
        <label><%= t('posts.editor.tags') %></label>
        <input type="text" name="tags" value="<%= post ? post.tags : '' %>" placeholder="<%= t('posts.editor.tagsPlaceholder') %>">
      </div>

      <!-- ===== 封面图片区域（支持上传文件或输入URL） ===== -->
      <div class="form-group">
        <label><%= t('posts.editor.cover') %></label>
        <div class="file-input-wrapper">
          <input type="file" name="cover_image" accept="image/jpeg,image/png,image/gif,image/webp">
          <span class="or-text"><%= t('posts.editor.or') %></span>
          <input type="text" name="cover_image_url" placeholder="<%= t('posts.editor.coverUrlPlaceholder') %>" style="flex:2; min-width: 250px;">
        </div>
        <div class="hint"><%= t('posts.editor.coverHint') %></div>
        <% if (post && post.cover_image) { %>
          <div class="current-image">
            <p><%= t('posts.editor.currentImage') %></p>
            <img src="<%= post.cover_image %>" alt="cover">
            <input type="hidden" name="existing_cover" value="<%= post.cover_image %>">
          </div>
        <% } %>
      </div>

      <div class="form-group">
        <label><%= t('posts.editor.bilibili') %></label>
        <input type="text" name="bilibili_embed" value="<%= post ? post.bilibili_embed : '' %>" placeholder="<%= t('posts.editor.bilibiliPlaceholder') %>">
      </div>
      <div class="form-group">
        <label><%= t('posts.editor.content') %></label>
        <textarea name="content" id="markdown-editor"><%= post ? post.content : '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn"><%= t('posts.editor.save') %></button>
        <a href="/admin" class="btn btn-secondary"><%= t('posts.editor.cancel') %></a>
      </div>
    </form>
  </div>
  <script src="/js/easymde.min.js"></script>
  <script src="/js/admin-editor.js"></script>
</body>
</html>