<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../../partials/theme-init') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('posts.trash.title') %></title>
  <link rel="stylesheet" href="/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .admin-container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
    .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .admin-header h1 { color: var(--hw-red); }
    .btn { display: inline-block; padding: 10px 20px; background: var(--hw-red); color: white; border: none; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 1rem; }
    .btn:hover { background: #c4000f; }
    .btn-secondary { background: var(--hw-medium-gray); }
    .btn-secondary:hover { background: #555; }
    .admin-nav { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; align-items: center; }
    .admin-nav a { color: var(--text); text-decoration: none; padding: 8px 16px; border-radius: 6px; }
    .admin-nav a:hover { background: var(--hw-light-gray); }
    .admin-nav a.active { background: var(--hw-light-gray); font-weight: 500; }
    .admin-nav form { display: inline; margin: 0; }
    .admin-nav form button { color: var(--text); background: none; border: none; cursor: pointer; padding: 8px 16px; border-radius: 6px; font-size: 1rem; }
    .admin-nav form button:hover { background: var(--hw-light-gray); }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--hw-border); }
    th { background: var(--hw-light-gray); }
    .action-btn { display: inline-block; padding: 4px 10px; margin-right: 4px; font-size: 0.85rem; border-radius: 4px; border: none; cursor: pointer; }
    .action-btn.restore { background: #28a745; color: #fff; }
    .action-btn.purge { background: #c4000f; color: #fff; }
    .alert { padding: 12px; border-radius: 6px; margin-bottom: 16px; }
    .alert-success { background: #d4edda; color: #155724; }
    .alert-error { background: #f8d7da; color: #721c24; }
    .empty { text-align: center; padding: 60px 20px; color: var(--text-faint); }
    .toolbar { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; gap: 12px; flex-wrap: wrap; }
    .toolbar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .toolbar-actions form { margin: 0; }

    @media (max-width: 768px) {
      .toolbar {
        flex-direction: column;
        align-items: stretch;
      }
      .toolbar-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .toolbar-actions .btn {
        width: 100%;
        text-align: center;
        box-sizing: border-box;
      }
      .table-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin-top: 16px;
        border-radius: 8px;
      }
      .table-scroll table {
        width: max-content;
        min-width: 100%;
        margin-top: 0;
        font-size: 0.85rem;
      }
      .table-scroll th,
      .table-scroll td {
        padding: 8px 10px;
        white-space: nowrap;
      }
    }
  </style>
</head>
<body data-lang="<%= lang %>">
  <div class="admin-container">
    <div class="admin-header">
      <h1><%= t('posts.trash.title') %></h1>
      <a href="/admin" class="btn btn-secondary"><%= t('posts.trash.backToPosts') %></a>
    </div>

    <%- include('../../partials/admin-nav', { active: 'trash', csrfToken }) %>

    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (!posts || posts.length === 0) { %>
      <div class="empty">
        <i class="fas fa-trash" style="font-size:48px;color:#ddd;"></i>
        <h3 style="margin-top:12px;"><%= t('posts.trash.empty') %></h3>
        <p><%= t('posts.trash.emptyHint') %></p>
      </div>
    <% } else { %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th><%= t('posts.trash.colTitle') %></th>
              <th><%= t('posts.trash.colTags') %></th>
              <th><%= t('posts.trash.colDeletedAt') %></th>
              <th><%= t('posts.trash.colActions') %></th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(post => { %>
              <tr>
                <td><%= post.id %></td>
                <td><%= post.title %></td>
                <td><%= post.tags || '—' %></td>
                <td><%= fmtTime(post.deleted_at) %></td>
                <td>
                  <form method="POST" action="/admin/posts/restore/<%= post.id %>" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="action-btn restore"><%= t('posts.trash.restore') %></button>
                  </form>
                  <form method="POST" action="/admin/posts/purge/<%= post.id %>" style="display:inline"
                        data-confirm="<%= t('posts.trash.confirmPurge') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="action-btn purge"><%= t('posts.trash.purge') %></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="toolbar">
      <span style="color:#999;">
        <% if (posts && posts.length > 0) { %><%= t('posts.trash.countPrefix') %><%= posts.length %><%= t('posts.trash.countSuffix') %><% } %>
      </span>
      <div class="toolbar-actions">
        <form method="POST" action="/admin/posts/trash/clean-orphans"
              data-confirm="<%= t('posts.trash.confirmCleanOrphans') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-secondary"><%= t('posts.trash.cleanOrphans') %></button>
        </form>
        <% if (posts && posts.length > 0) { %>
          <form method="POST" action="/admin/posts/trash/empty"
                data-confirm="<%= t('posts.trash.confirmEmpty') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn"><%= t('posts.trash.emptyTrash') %></button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/toast.js"></script>
</body>
</html>