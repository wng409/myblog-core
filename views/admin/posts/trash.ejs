<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../../partials/theme-init') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('posts.trash.title') %></title>
  <link rel="stylesheet" href="/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <%- include('../../partials/brand-color') %>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body data-lang="<%= lang %>">
  <div class="admin-container">
    <div class="admin-header">
      <h1><%= t('posts.trash.title') %></h1>
      <a href="/admin" class="btn btn-secondary"><%= t('posts.trash.backToPosts') %></a>
    </div>

    <%- include('../../partials/admin-nav', { active: 'trash', csrfToken }) %>

    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (!posts || posts.length === 0) { %>
      <div class="empty">
        <i class="fas fa-trash empty-icon"></i>
        <h3 style="margin-top:12px;"><%= t('posts.trash.empty') %></h3>
        <p><%= t('posts.trash.emptyHint') %></p>
      </div>
    <% } else { %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th><%= t('posts.trash.colTitle') %></th>
              <th><%= t('posts.trash.colTags') %></th>
              <th><%= t('posts.trash.colDeletedAt') %></th>
              <th><%= t('posts.trash.colActions') %></th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(post => { %>
              <tr>
                <td><%= post.id %></td>
                <td><%= post.title %></td>
                <td><%= post.tags || '—' %></td>
                <td><%= fmtTime(post.deleted_at) %></td>
                <td>
                  <form method="POST" action="/admin/posts/restore/<%= post.id %>" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="action-btn restore"><%= t('posts.trash.restore') %></button>
                  </form>
                  <form method="POST" action="/admin/posts/purge/<%= post.id %>" style="display:inline"
                        data-confirm="<%= t('posts.trash.confirmPurge') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="action-btn purge"><%= t('posts.trash.purge') %></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="toolbar">
      <span class="text-muted">
        <% if (posts && posts.length > 0) { %><%= t('posts.trash.countPrefix') %><%= posts.length %><%= t('posts.trash.countSuffix') %><% } %>
      </span>
      <div class="toolbar-actions">
        <form method="POST" action="/admin/posts/trash/clean-orphans"
              data-confirm="<%= t('posts.trash.confirmCleanOrphans') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-secondary"><%= t('posts.trash.cleanOrphans') %></button>
        </form>
        <% if (posts && posts.length > 0) { %>
          <form method="POST" action="/admin/posts/trash/empty"
                data-confirm="<%= t('posts.trash.confirmEmpty') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn"><%= t('posts.trash.emptyTrash') %></button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/toast.js"></script>
</body>
</html>