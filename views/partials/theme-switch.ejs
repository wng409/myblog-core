<%
  var _variant = (typeof variant !== 'undefined') ? variant : 'pc';
  var _id = (typeof id !== 'undefined') ? id : 'themeToggle';
  var _switchClass = _variant === 'mobile' ? 'theme-switch theme-switch--circle' : 'theme-switch';
%>
<div class="<%= _switchClass %>" data-theme-switch>
  <button class="theme-toggle" id="<%= _id %>" type="button" aria-label="<%= t('theme.toggle') %>" aria-haspopup="true" aria-expanded="false">
    <i class="theme-toggle-icon fas fa-circle-half-stroke" aria-hidden="true"></i>
    <% if (_variant === 'mobile') { %><span><%= t('theme.label') %></span><% } %>
  </button>
  <div class="theme-menu" role="menu" aria-label="<%= t('theme.menu') %>">
    <button type="button" role="menuitemradio" aria-checked="false" data-theme-value="system"><i class="fas fa-circle-half-stroke" aria-hidden="true"></i><span><%= t('theme.system') %></span></button>
    <button type="button" role="menuitemradio" aria-checked="false" data-theme-value="light"><i class="fas fa-sun" aria-hidden="true"></i><span><%= t('theme.light') %></span></button>
    <button type="button" role="menuitemradio" aria-checked="false" data-theme-value="dark"><i class="fas fa-moon" aria-hidden="true"></i><span><%= t('theme.dark') %></span></button>
  </div>
</div>