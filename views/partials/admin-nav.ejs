<nav class="admin-nav">
  <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>"><%= t('admin.nav.posts') %></a>
  <a href="/admin/settings" class="<%= active === 'settings' ? 'active' : '' %>"><%= t('admin.nav.settings') %></a>
  <a href="/admin/site" class="<%= active === 'site' ? 'active' : '' %>"><%= t('admin.nav.site') %></a>
  <a href="/admin/logs" class="<%= active === 'logs' ? 'active' : '' %>"><%= t('admin.nav.logs') %></a>
  <a href="/admin/profile" class="<%= active === 'profile' ? 'active' : '' %>"><%= t('admin.nav.profile') %></a>
</nav>

<!-- 主题切换：由 admin-nav.js 搬到顶栏右侧按钮组末尾（最右） -->
<div class="admin-nav-tools">
  <%- include('./theme-switch', { variant: 'admin', id: 'themeToggleAdmin' }) %>
</div>

<!-- 退出登录：已从导航移出，由 admin-nav.js 注入 .header-actions，点击需二次确认 -->
<form method="POST" action="/admin/logout" class="admin-logout" hidden>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button type="submit" aria-label="<%= t('admin.logout') %>"><i class="fas fa-sign-out-alt" aria-hidden="true"></i><span><%= t('admin.logout') %></span></button>
</form>

<script src="/js/admin-nav.js" defer></script>
<script src="/js/admin-ui.js" defer></script>